{
  "name": "aimtp",
  "version": "0.1.34",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node tests/sdk.test.js && node tests/reference-router.test.js && node tests/reference-flow.test.js && node tests/signature-policy.test.js && node tests/cap-mint.test.js && node tests/mailbox-store.test.js && node tests/runtime-relay.test.js && node tests/intentos-ui.test.js",
    "test:receipts": "jest --config jest.config.cjs --runInBand tests/receipts.test.ts",
    "build": "tsc -p tsconfig.json",
    "ship": "node scripts/ship.js",
    "demo": "npm run build && node dist/runtime/demo-run.js",
    "demo:web": "node examples/web-inbox/server.js",
    "replay:intentos": "node tools/intentos-replay.mjs --envelope tests/fixtures/intentos-envelope-valid.json --receipt-jsonl tests/fixtures/intentos-receipts-valid.jsonl --strict && node tools/intentos-replay.mjs --envelope tests/fixtures/intentos-envelope-denied.json --receipt-jsonl tests/fixtures/intentos-receipts-denied.jsonl --strict",
    "cli:send": "node cli/aimtp-send.mjs",
    "cap:mint": "node tools/aimtp-cap.mjs mint --help",
    "cap:inspect": "node tools/aimtp-cap.mjs inspect --help",
    "verify:dist": "node -e \"const fs=require('fs'); const s=fs.readFileSync('dist/runtime/relay.js','utf8'); const required=['AIMTP_ALLOWED_RECIPIENTS','AIMTP_RECIPIENT_KEYS','AIMTP_CORS_ORIGINS','/peek']; for (const token of required) { if (!s.includes(token)) { console.error('missing', token); process.exit(1); } }\""
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sdk": {
      "require": "./dist/sdk/index.js",
      "types": "./dist/sdk/index.d.ts"
    },
    "./runtime": {
      "require": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^2.1.1",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimtp.dev/schemas/envelope.schema.json",
  "title": "AIMTP Envelope",
  "type": "object",
  "required": ["spec", "id", "timestamp", "message"],
  "additionalProperties": true,
  "$defs": {
    "intent_type": {
      "anyOf": [
        {"type": "string", "enum": ["task.request", "task.response", "task.update", "task.cancel", "event", "query"]},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    },
    "intent_priority": {
      "anyOf": [
        {"type": "string", "enum": ["low", "normal", "high", "urgent"]},
        {"type": "integer", "minimum": 0, "maximum": 100}
      ]
    },
    "ai_intent": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": {"$ref": "#/$defs/intent_type"},
        "priority": {"$ref": "#/$defs/intent_priority"},
        "deadline": {"type": "string", "format": "date-time"},
        "requires_ack": {"type": "boolean"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "ai_action_type": {
      "anyOf": [
        {"type": "string", "enum": ["invoke", "route", "transform", "store", "notify"]},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    },
    "ai_action": {
      "type": "object",
      "required": ["id", "type", "inputs"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/ai_action_type"},
        "inputs": {"type": "object", "additionalProperties": true},
        "constraints": {"type": "object", "additionalProperties": true},
        "on_success": {"type": "object", "additionalProperties": true},
        "on_failure": {"type": "object", "additionalProperties": true}
      }
    },
    "ai_capabilities": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "offered": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "ai_negotiation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "offer": {"type": "object", "additionalProperties": true},
        "counter": {"type": "object", "additionalProperties": true},
        "accept": {"type": "boolean"},
        "reject": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "spec": {"type": "string", "const": "aimtp/0.1"},
    "id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "sender": {"type": "string"},
    "recipient": {"type": "string"},
    "intent": {
      "oneOf": [
        {"type": "string"},
        {"$ref": "#/$defs/ai_intent"}
      ]
    },
    "actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/ai_action"}
    },
    "capabilities": {"$ref": "#/$defs/ai_capabilities"},
    "negotiation": {"$ref": "#/$defs/ai_negotiation"},
    "message": {"$ref": "message.schema.json"},
    "task": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": true,
          "properties": {
            "kind": {"type": "string", "const": "request"},
            "id": {"type": "string", "minLength": 1},
            "type": {"type": "string"},
            "input": {"type": "object", "additionalProperties": true},
            "expects_response": {"type": "boolean"},
            "metadata": {"type": "object", "additionalProperties": true}
          },
          "not": {
            "anyOf": [
              {"required": ["in_response_to"]},
              {"required": ["status"]},
              {"required": ["output"]},
              {"required": ["error"]}
            ]
          }
        },
        {
          "type": "object",
          "required": ["kind", "id", "in_response_to", "status"],
          "additionalProperties": true,
          "properties": {
            "kind": {"type": "string", "const": "response"},
            "id": {"type": "string", "minLength": 1},
            "type": {"type": "string"},
            "in_response_to": {"type": "string", "minLength": 1},
            "status": {"type": "string", "enum": ["pending", "running", "succeeded", "failed"]},
            "output": {"type": "object", "additionalProperties": true},
            "error": {
              "type": "object",
              "required": ["code", "message"],
              "additionalProperties": true,
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "message": {"type": "string", "minLength": 1},
                "details": {"type": "object", "additionalProperties": true}
              }
            },
            "metadata": {"type": "object", "additionalProperties": true}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "failed"}}},
              "then": {
                "required": ["error"],
                "not": {"required": ["output"]}
              }
            },
            {
              "if": {"properties": {"status": {"const": "succeeded"}}},
              "then": {
                "not": {"required": ["error"]}
              }
            },
            {
              "if": {"properties": {"status": {"enum": ["pending", "running"]}}},
              "then": {
                "not": {
                  "anyOf": [{"required": ["output"]}, {"required": ["error"]}]
                }
              }
            }
          ]
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        {
          "anyOf": [
            { "required": ["kid"] },
            { "required": ["key_id"] }
          ]
        },
        {
          "anyOf": [
            { "required": ["sig"] },
            { "required": ["signature"] }
          ]
        }
      ],
      "properties": {
        "kid": {"type": "string", "minLength": 1},
        "sig": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1},
        "alg": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

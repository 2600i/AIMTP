{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimtp.net/schemas/mailbox-poll-item.schema.json",
  "type": "object",
  "required": ["envelope", "lease_id", "lease_expires_at", "retry_count", "delivery_attempt"],
  "properties": {
    "envelope": { "$ref": "./envelope.schema.json" },
    "lease_id": { "type": "string", "minLength": 1 },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "retry_count": { "type": "integer", "minimum": 0 },
    "delivery_attempt": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}

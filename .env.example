# Server
# PORT=8787
# AIMTP_BIND_HOST=127.0.0.1
# AIMTP_RELAY_PATH=/aimtp
# AIMTP_HEALTH_PATH=/healthz
# AIMTP_READY_PATH=/readyz
# AIMTP_MAX_BODY_BYTES=1048576
# AIMTP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
#
# Auth
# AIMTP_API_KEY=
# AIMTP_RECIPIENT_KEYS=agent-a:key-a,agent-b:key-b
# AIMTP_KEY_RECIPIENTS=key-a=agent-a,agent-b;key-b=agent-c
#
# Allowlists
# AIMTP_ALLOWED_RECIPIENTS=demo-agent
# AIMTP_ALLOWLIST_RECIPIENTS=1
# AIMTP_ALLOWED_SENDERS=
#
# Mailbox store
# AIMTP_STORE=sqlite
# AIMTP_MAILBOX_STORE=
# AIMTP_MAILBOX_SQLITE_PATH=runtime/aimtp-mailbox.sqlite
# AIMTP_MAILBOX_TTL_MS=600000
# AIMTP_MAILBOX_MAX_QUEUE_LENGTH=100
# AIMTP_MAILBOX_MAX_RECIPIENTS=1000
# AIMTP_MAILBOX_CLEANUP_INTERVAL_MS=
# AIMTP_MAILBOX_LEASE_MS=30000
# AIMTP_MAILBOX_MAX_RETRIES=5
# AIMTP_MAILBOX_RETRY_BASE_MS=1000
# AIMTP_MAILBOX_RETRY_MAX_MS=30000
#
# Redis (use AIMTP_STORE=redis)
# AIMTP_REDIS_URL=redis://localhost:6379
# AIMTP_REDIS_HOST=
# AIMTP_REDIS_PORT=6379
# AIMTP_REDIS_DB=0
# AIMTP_REDIS_USERNAME=
# AIMTP_REDIS_PASSWORD=
# AIMTP_REDIS_KEY_PREFIX=aimtp:mailbox:
# AIMTP_REDIS_CLI_PATH=redis-cli
# AIMTP_REDIS_TIMEOUT_MS=1000
# AIMTP_REDIS_LOCK_TTL_MS=10000
# AIMTP_REDIS_LOCK_ACQUIRE_TIMEOUT_MS=5000
# AIMTP_REDIS_LOCK_RETRY_DELAY_MS=20
# AIMTP_REDIS_LEASE_RESULT_TTL_MS=300000
#
# Runtime identity
# AIMTP_RELAY_INSTANCE_ID=relay-1
#
# Signature policy
# AIMTP_SIGNATURE_POLICY=off
# AIMTP_TRUSTED_KEYS=
# AIMTP_TRUSTED_KEYS_FILE=
# AIMTP_SIGNATURE_CLOCK_SKEW_SEC=0
#
# IntentOS (opt-in read-only projection of relay traffic)
# INTENTOS=on
# AIMTP_INTENTOS_SQLITE_PATH=runtime/aimtp-intentos.sqlite
# AIMTP_INTENTOS_MAX_INTENTS=500
#
# Observability
# AIMTP_LOG_SUMMARY_INTERVAL_MS=60000

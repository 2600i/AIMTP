{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aimtp.net/spec/federation-handshake-v0.4.schema.json",
  "title": "IntentOS Federation Handshake v0.4.0 (Draft)",
  "description": "Opt-in draft payloads for local federation handshake scaffolding.",
  "oneOf": [
    {
      "$ref": "#/$defs/HandshakeHello"
    },
    {
      "$ref": "#/$defs/HandshakeAck"
    }
  ],
  "$defs": {
    "HandshakeHello": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "HandshakeHello"
        },
        "protocolVersion": {
          "const": "0.4"
        },
        "helloId": {
          "type": "string",
          "minLength": 1
        },
        "senderPeerId": {
          "type": "string",
          "minLength": 1
        },
        "recipientPeerId": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "capabilitiesOffered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilitiesRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "peerProof": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keyId": {
              "type": "string",
              "minLength": 1
            },
            "nonce": {
              "type": "string",
              "minLength": 1
            },
            "signature": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "keyId",
            "nonce",
            "signature"
          ]
        },
        "identityAnchorSetId": {
          "type": "string",
          "minLength": 1
        },
        "identityAnchorsInline": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "helloId",
        "senderPeerId",
        "recipientPeerId",
        "nonce",
        "timestamp"
      ]
    },
    "HandshakeAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "HandshakeAck"
        },
        "protocolVersion": {
          "const": "0.4"
        },
        "helloId": {
          "type": "string",
          "minLength": 1
        },
        "senderPeerId": {
          "type": "string",
          "minLength": 1
        },
        "recipientPeerId": {
          "type": "string",
          "minLength": 1
        },
        "nonce": {
          "type": "string",
          "minLength": 1
        },
        "helloTimestamp": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "acceptedIdentityAnchors": {
          "type": "boolean"
        },
        "resolvedAnchorSetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "capabilitiesAccepted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilitiesMissing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "protocolVersion",
        "helloId",
        "senderPeerId",
        "recipientPeerId",
        "nonce",
        "helloTimestamp",
        "accepted",
        "acceptedIdentityAnchors",
        "resolvedAnchorSetId",
        "capabilitiesAccepted",
        "capabilitiesMissing",
        "timestamp"
      ]
    }
  }
}

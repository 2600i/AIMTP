{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aimtp.net/spec/revocation-proof-v0.4.schema.json",
  "title": "IntentOS Revocation Proof v0.4.0 (Draft)",
  "description": "Detached Ed25519 proof for a revocation set artifact.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "RevocationProof"
    },
    "version": {
      "const": "0.4"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "alg": {
      "const": "ed25519"
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "revocationSetId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "type",
    "version",
    "keyId",
    "alg",
    "createdAt",
    "signature"
  ]
}
